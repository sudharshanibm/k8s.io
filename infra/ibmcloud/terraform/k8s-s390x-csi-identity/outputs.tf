output "access_group_id" {
  description = "Access group assigned to the service ID generated by Secrets Manager."
  value       = ibm_iam_access_group.vpc_csi.id
}

output "resource_group_id" {
  description = "Resource group ID to place in the CSI driver's slclient.toml configuration."
  value       = data.ibm_resource_group.vpc.id
}

output "secrets_manager_secret_id" {
  description = "ID of the IAM credentials secret consumed by External Secrets."
  value       = ibm_sm_iam_credentials_secret.vpc_csi.secret_id
}

output "external_secrets_remote_key" {
  description = "IBM External Secrets remoteRef key for the generated IAM credential."
  value       = "iam_credentials/${ibm_sm_iam_credentials_secret.vpc_csi.secret_id}"
}

output "external_secret_manifest" {
  description = "Credential-free ExternalSecret manifest using the existing secretstore-ibm-k8s ClusterSecretStore. Review before applying to the matching cluster."
  value = templatefile("${path.module}/external-secret.yaml.tftpl", {
    secret_id         = ibm_sm_iam_credentials_secret.vpc_csi.secret_id
    region            = var.region
    resource_group_id = data.ibm_resource_group.vpc.id
  })
}
