apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: storage-secret-store
  namespace: kube-system
spec:
  refreshInterval: 1m
  secretStoreRef:
    name: secretstore-ibm-k8s
    kind: ClusterSecretStore
  target:
    name: storage-secret-store
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        slclient.toml: |
          [server]
          debug_trace = false

          [vpc]
          iam_client_id = "bx"
          iam_client_secret = "bx"
          g2_token_exchange_endpoint_url = "https://iam.cloud.ibm.com"
          g2_riaas_endpoint_url = "https://${region}.iaas.cloud.ibm.com"
          g2_resource_group_id = "${resource_group_id}"
          g2_api_key = "{{ .api_key }}"
          provider_type = "g2"
  data:
    - secretKey: api_key
      remoteRef:
        key: iam_credentials/${secret_id}
